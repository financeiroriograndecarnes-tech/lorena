# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados
# reais do seu banco Neon. O ".env" nunca deve ser commitado no git.

# String de conexao do Neon: copie em "Connection string" no dashboard do
# projeto (aba "Connect"). Comeca com "postgresql://...".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require

# Qualquer texto aleatorio -- usado pelo Flask para assinar sessoes/mensagens.
SECRET_KEY=troque-por-um-texto-aleatorio-qualquer
